{
  "redirects": [
    { "source": "/pietra-viva",        "destination": "/pietra-viva-new",          "permanent": true },
    { "source": "/pietra-viva/:path*", "destination": "/pietra-viva-new/:path*",   "permanent": true },
    { "source": "/pietraviva",         "destination": "/pietra-viva-new",          "permanent": true },
    { "source": "/pietra_viva",        "destination": "/pietra-viva-new",          "permanent": true },
    { "source": "/menu/alfredo",       "destination": "/pietra-viva-new",          "permanent": true },
    { "source": "/menu/el-encuentro",  "destination": "/el-encuentro",            "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Language", "value": "it" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
